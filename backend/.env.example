GEMINI_API_KEY=paste-your-gemini-api-key-here
# Gemini's fast, free-tier eligible Flash model.
GEMINI_MODEL=gemini-3.5-flash-lite
# Maximum accepted audio upload size for POST /api/transcriptions (10 MiB by default).
MAX_AUDIO_UPLOAD_BYTES=10485760
# Comma-separated development origins. Expo commonly runs on these ports.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,exp://localhost:8081
# A phone reaches the API at a LAN address, not localhost, so any host on an
# Expo dev port is allowed too. Set to an empty value to require the list above.
CORS_ORIGIN_REGEX=^(https?|exp)://[^/\s]+:(8081|19000|19006)$

# Keep false while developing. Set true only when the route is clear and the
# backend is running on or can SSH into the robot.
ROBOT_ENABLED=false
# local = backend runs on the robot. ssh = backend runs on your Mac and uses SSH
# key auth to run commands on the robot.
ROBOT_TRANSPORT=local
ROBOT_HOST=bracketbot-0186.local
ROBOT_USER=bracketbot
ROBOT_APP_DIR=/home/bracketbot/bbapps/hampy_demo
# Map app shelf numbers to saved station names in hampy_demo/stations.json.
ROBOT_STATION_BY_SHELF=1:table_1,2:table_2,3:table_3
ROBOT_DROPOFF_STATION=table_2
# {station}, {shelf}, and {item} are available in the pickup filename template.
ROBOT_PICKUP_MOTION_TEMPLATE=motions/{station}_pickup.json
ROBOT_DROP_MOTION=motions/drop.json
ROBOT_COMMAND_TIMEOUT_SECONDS=240
